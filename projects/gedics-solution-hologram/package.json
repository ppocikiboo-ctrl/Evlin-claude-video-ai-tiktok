{
  "name": "gedics-solution-hologram",
  "version": "1.0.0",
  "private": true,
  "description": "Gedics Solution 10 s TikTok edit: romantic hologram glass effect (Remotion)",
  "scripts": {
    "prep": "bash scripts/prep_footage.sh && python3 scripts/make_audio.py",
